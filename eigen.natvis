<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <!-- 针对 Eigen::Matrix -->
  <Type Name="Eigen::Matrix&lt;*,*,*&gt;">
    <DisplayString>{{ {*(double*)m_data}, rows={m_rows}, cols={m_cols} }}</DisplayString>
    <Expand>
      <Item Name="[storage]">m_storage</Item>
      <Item Name="[rows]">m_rows</Item>
      <Item Name="[cols]">m_cols</Item>
      <ArrayItems>
        <Size>m_rows * m_cols</Size>
        <ValuePointer>m_storage.m_data.array</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>
</AutoVisualizer>